```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
target/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.ENV
.env
.env.*
.pytest_cache/
.mypy_cache/
.coverage
coverage/

# Compiled and binary files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Environment variables
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Testing
coverage/
htmlcov/
.nyc_output/
```