rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety Net to block all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable global helper primitive functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // UserProfile schema validation function
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().size() <= 4
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256;
    }

    // SavedCoupon schema validation function
    function isValidSavedCoupon(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'selections', 'subJackpotSize', 'createdAt'])
        && data.keys().size() <= 8
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.subJackpotSize is int && (data.subJackpotSize == 17 || data.subJackpotSize == 15 || data.subJackpotSize == 14 || data.subJackpotSize == 13 || data.subJackpotSize == 12);
    }

    // Isolated tenants matching for user-profile resources
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'lastActiveAt']);
      allow delete: if false;

      // Double nested subcollection for coupons tracking
      match /coupons/{couponId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidId(couponId)
          && isValidSavedCoupon(incoming()) 
          && incoming().userId == request.auth.uid
          && incoming().id == couponId
          && incoming().createdAt is string;
          
        allow update: if isOwner(userId)
          && isValidId(couponId)
          && isValidSavedCoupon(incoming())
          && incoming().userId == request.auth.uid
          && incoming().id == couponId
          && incoming().createdAt == existing().createdAt
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'selections', 'subJackpotSize', 'strategy', 'cost', 'updatedAt'])
          );
          
        allow delete: if isOwner(userId);
      }
    }
  }
}
